# Copy to .env and replace the example values before starting Docker Compose.
# Generate JWT_SECRET with: openssl rand -base64 48
DB_PASSWORD=replace-with-a-long-random-database-password
JWT_SECRET=replace-with-at-least-32-random-characters
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-unique-password-of-at-least-12-characters
BOOTSTRAP_ADMIN_NAME=System Administrator
# Set this to the exact HTTPS origin of your frontend app in production.
CORS_ALLOWED_ORIGINS=http://localhost:3000