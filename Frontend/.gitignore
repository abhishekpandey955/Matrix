# ============================================================
# MediCare Frontend — .gitignore
# ============================================================

# ---- Logs ----
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
bun-debug.log*

# ---- Dependencies ----
node_modules/

# ---- Build outputs ----
dist/
dist-ssr/
.output/
.vinxi/
.nitro/
.tanstack/

# ---- Environment files (NEVER commit secrets) ----
.env
.env.local
.env.*.local
*.local

# ---- Bun ----
bun.lock

# ---- Cloudflare / Wrangler ----
.wrangler/
.dev.vars

# ---- Test coverage ----
coverage/

# ---- OS files ----
.DS_Store
Thumbs.db

# ---- Editor files ----
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ---- TypeScript incremental build cache ----
*.tsbuildinfo
